{
  "name": "@flybyme/mesh-web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "The browser half of the mesh framework: reactivity, DOM, routing, applications and extensions",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc && node scripts/copy-assets.js",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@flybyme/mesh": "github:FLYBYME/mesh#v2.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "happy-dom": "^20.12.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "scripts",
    "src",
    "tsconfig.json"
  ]
}
