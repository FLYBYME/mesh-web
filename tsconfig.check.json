// src/ and test/ together, with node types for the tests.
//
// The `paths` mapping is what lets a test import `@flybyme/mesh-web` **by name**, the way an outside
// author does, rather than by a relative path into the package's insides. It mirrors the alias
// `vitest.browser.config.ts` sets for the same reason — a test that reached in through `../src` would
// be testing something no consumer can reach, and the browser-testing harness in particular exists to
// be used from another repository entirely.
{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        "rootDir": ".",
        "types": ["node"],
        "baseUrl": ".",
        "paths": {
            "@flybyme/mesh-web": ["./src/index.ts"],
            "@flybyme/mesh-web/testing": ["./src/testing/index.ts"],
            "@flybyme/mesh-web/testing/config": ["./src/testing/config.ts"],
            "@flybyme/mesh-web/config": ["./src/testing/config.ts"]
        }
    },
    "include": ["src/**/*.ts", "test/**/*.ts"]
}
