// src/ and test/ together, with node types for the tests.
//
// `server/` is checked by its own project (`server/tsconfig.json`) because it is node code and the
// browser package sets `types: []` deliberately. It appears here only because `test/server/*` imports
// it, so the path mapping is needed to resolve the package name — the imports read as they will once
// the packages are installed rather than as relative paths.
{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        "rootDir": ".",
        "types": ["node"],
        "baseUrl": ".",
        "paths": {
            "@flybyme/mesh-web-protocol": ["./server/protocol/src/index.ts"]
        }
    },
    "include": ["src/**/*.ts", "test/**/*.ts"]
}
